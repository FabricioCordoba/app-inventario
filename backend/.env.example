# App
PORT=3000
APP_TIMEZONE=America/Argentina/Buenos_Aires
FRONTEND_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=bv_barker_inventarios
DB_LOGGING=false

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Seed admin (solo desarrollo)
SEED_ADMIN_EMAIL=admin@bvbarker.local
SEED_ADMIN_PASSWORD=Admin123!

# Mail (opcional en desarrollo; sin MAIL_HOST se imprime el enlace en los logs)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
